{
  "name": "Life as a Graphic Designer EP06",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5.2.5-22-bookworm",
  "remoteUser": "node",
  "forwardPorts": [
    3011,
    3012
  ],
  "portsAttributes": {
    "3011": {
      "label": "Remotion EP06 Studio",
      "onAutoForward": "notify"
    },
    "3012": {
      "label": "EP06 evaluation MP4",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "REMOTION_BROWSER_EXECUTABLE": "/usr/bin/chromium"
  },
  "postCreateCommand": "bash /workspaces/${localWorkspaceFolderBasename}/life-as-graphic-designer-ep06/.devcontainer/setup.sh",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/life-as-graphic-designer-ep06"
}
