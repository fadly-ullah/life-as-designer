{
  "name": "Life as a Graphic Designer EP05",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5.2.5-22-bookworm",
  "remoteUser": "node",
  "forwardPorts": [
    3009,
    3010
  ],
  "portsAttributes": {
    "3009": {
      "label": "Remotion EP05 Studio",
      "onAutoForward": "notify"
    },
    "3010": {
      "label": "EP05 evaluation MP4",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "REMOTION_BROWSER_EXECUTABLE": "/usr/bin/chromium"
  },
  "postCreateCommand": "bash /workspaces/${localWorkspaceFolderBasename}/life-as-graphic-designer-ep05/.devcontainer/setup.sh",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/life-as-graphic-designer-ep05"
}
