{
  "name": "Life as a Graphic Designer EP03",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5.2.5-22-bookworm",
  "remoteUser": "node",
  "forwardPorts": [
    3005,
    3006
  ],
  "portsAttributes": {
    "3005": {
      "label": "Remotion EP03 Studio",
      "onAutoForward": "notify"
    },
    "3006": {
      "label": "EP03 MP4 evaluation player",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "REMOTION_BROWSER_EXECUTABLE": "/usr/bin/chromium"
  },
  "postCreateCommand": "bash /workspaces/${localWorkspaceFolderBasename}/life-as-graphic-designer-ep03/.devcontainer/setup.sh",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/life-as-graphic-designer-ep03"
}
