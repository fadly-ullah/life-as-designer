{
  "name": "Life as a Graphic Designer EP01 V2",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5.2.5-22-bookworm",
  "remoteUser": "node",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/life-as-graphic-designer-ep01-v2",
  "forwardPorts": [3001],
  "portsAttributes": {
    "3001": {"label": "Remotion Studio V2", "onAutoForward": "notify"}
  },
  "containerEnv": {
    "REMOTION_BROWSER_EXECUTABLE": "/usr/bin/chromium",
    "NODE_USE_ENV_PROXY": "1"
  },
  "postCreateCommand": "bash /workspaces/${localWorkspaceFolderBasename}/life-as-graphic-designer-ep01-v2/.devcontainer/setup.sh"
}
