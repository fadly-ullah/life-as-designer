{
  "name": "Life as a Graphic Designer EP04",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5.2.5-22-bookworm",
  "remoteUser": "node",
  "forwardPorts": [
    3007,
    3008
  ],
  "portsAttributes": {
    "3007": {
      "label": "Remotion EP04 Studio",
      "onAutoForward": "notify"
    },
    "3008": {
      "label": "EP04 evaluation MP4",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "REMOTION_BROWSER_EXECUTABLE": "/usr/bin/chromium"
  },
  "postCreateCommand": "bash /workspaces/${localWorkspaceFolderBasename}/life-as-graphic-designer-ep04/.devcontainer/setup.sh",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/life-as-graphic-designer-ep04"
}
